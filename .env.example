# Paths are relative to repository root. Run commands from that directory.
BOARDS_CONFIG=config/boards.csv
DATA_DIR=data/local
DUCKDB_PATH=data/local/warehouse.duckdb
SNAPSHOT_TIMEZONE=Asia/Ho_Chi_Minh
DBT_TARGET=local
# Optional GCP variant. Databricks Free Edition uses databricks.yml and CLI OAuth instead.
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=asia-southeast1
GCS_BUCKET=your-project-id-tech-jobs-raw
BQ_RAW_DATASET=tech_jobs_raw
BQ_ANALYTICS_DATASET=tech_jobs_analytics
# Compose: change both passwords before starting Kestra.
POSTGRES_PASSWORD=change-me-local-only
KESTRA_USER=admin@example.com
KESTRA_PASSWORD=ChangeMe123456!
